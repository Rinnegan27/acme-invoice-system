# ---------------------------------------------------------------------------
# xAI / Grok (optional — leave blank for offline stub / CLI prompt)
# Copy: cp .env.example .env
# Live:  XAI_API_KEY=xai-<your-real-key>
# ---------------------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-3

# PaymentPermit HMAC secret (signs single-use payment authorizations).
# Leave BLANK — the first run creates a strong secret and writes it to .env.
# Or set your own (min 16 chars, not a placeholder):
#   python -c "import secrets; print(secrets.token_hex(32))"
# You can delete this line entirely; blank/missing auto-creates.
GALATIQ_PERMIT_SECRET=

# Optional separate HMAC secret for signed workbench sessions.
# When blank, the app reuses GALATIQ_PERMIT_SECRET.
GALATIQ_SESSION_SECRET=

# High-value Grok approval mode:
#   unset — deterministic (one temperature-0 call) when GALATIQ_PROFILE=prod
#   1     — force deterministic + ApprovalAudit
#   0     — force critique-loop reflection (even in prod)
# GALATIQ_HV_DETERMINISTIC=1

# Master-data profile (default prod when unset):
#   prod  — strict catalog unit prices + PO coverage (no soft bands)
#   case  — soft price bands for the Galatiq case corpus / scenario-proof
# GALATIQ_PROFILE=prod

# CLI human approve/reject/escalate gate (VP scrutiny):
#   unset — prompt on TTY; auto VP agent when stdin is not a TTY
#   1     — always use automated VP agent (CI / pipes)
# GALATIQ_CLI_AUTO_VP=1

# Optional OTLP/HTTP JSON collector (best-effort POST of otlp_traces.json batch)
# GALATIQ_OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Span lines on stderr (stdout stays JSON-pure for CLI)
# GALATIQ_SPAN_CONSOLE=1
